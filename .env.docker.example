# Copy the needed values into .env; preserve your existing VITE_API_URL.
# This URL must be reachable from the user's browser.
VITE_API_URL=https://api.example.com/api
VITE_REPORTS_URL=https://reports.example.com
# Empty means use the origin of VITE_API_URL.
VITE_SOCKET_URL=
VITE_SOCKET_PATH=/socket.io
FRONTEND_PORT=8080
